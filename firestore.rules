rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user profile
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if user is employer
    function isEmployer() {
      return isAuthenticated() && getUserData().role == 'employer';
    }

    // Helper function to check if user is attendant
    function isAttendant() {
      return isAuthenticated() && (getUserData().role == 'attendant' || getUserData().role == 'employer');
    }

    // Helper function to check if user is bookkeeper or employer
    function isBookkeeperOrEmployer() {
      return isAuthenticated() && (getUserData().role == 'bookkeeper' || getUserData().role == 'employer');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isEmployer());
    }

    // Budget Periods collection
    match /budgets/{budgetId} {
      allow read: if isAuthenticated();
      allow write: if isEmployer();
    }

    // Runbook Tasks collection
    match /runbook_tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isEmployer();
    }

    // Shift Records collection
    match /shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // Handover Notes collection
    match /handovers/{handoverId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Emergency Broadcasts collection
    match /emergencies/{emergencyId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }
  }
}
